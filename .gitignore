# ============================================================
# LEGAL-GPT PUBLIC REPOSITORY .gitignore
# STRICT DATA ISOLATION & SECRETS PREVENTION
# ============================================================

# Environment variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert
credentials.json
secrets.json
token.json
tokens.json
id_rsa
id_ed25519
*.secret

# Local Databases, SQLite & Stores
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
vectorstore/
indexes/
embeddings/
models/

# Private Directories & Data Firewalls
data/private/
private_data/
private/
secrets/
credentials/
evidence/
case_files/
user_data/
uploads/
downloads/
archives/
transcripts_private/
raw_evidence/
forensic/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# IDE, OS, & Machine Configuration
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Audit Dumps
*.log
logs/
audit_dumps/
session_dumps/
traces/
data/traces/
*.jsonl

# Ingestion Caches & Large Local Artifacts
.cache/
data/cache/
*.gguf
*.lora
*.bin
*.safetensors
unsloth_runs/

# Exceptions: Allow public schemas & synthetic data only
!data/public/
!data/synthetic/
!tests/data/synthetic/
